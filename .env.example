# Copy this file to .env in the repo root and fill in your key.
# python-dotenv searches upward from each script's folder, so one .env
# at the repo root is picked up by modules 01, 02 and 03.
# .env is gitignored - never commit your real key.

# Create a key at https://console.anthropic.com/settings/keys
# Use a key created inside a workspace (Settings -> Workspaces); keys that
# aren't scoped to a workspace are rejected by the API.
ANTHROPIC_API_KEY=

# Main agent model (module 01 agents, module 02 expense agent, module 03 tests).
# claude-opus-5-5 is more capable; claude-sonnet-5-5 costs about half as much.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Smaller, cheaper model for the "self-prompting" LLM calls made inside
# module 03's tools (self_prompting_server.py, validate_at_source_server.py)
ANTHROPIC_SMALL_MODEL=claude-haiku-4-5
